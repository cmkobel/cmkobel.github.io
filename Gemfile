source "https://rubygems.org"

# GitHub Pages builds the site with the github-pages gem; use the same versions locally.
# Run with `pixi run install` once, then `pixi run serve`.
gem "github-pages", group: :jekyll_plugins

gem "webrick", "~> 1.8" # web server for `jekyll serve`, no longer bundled with Ruby
gem "erb"               # some Rubies (e.g. Arch Linux's) ship without it
